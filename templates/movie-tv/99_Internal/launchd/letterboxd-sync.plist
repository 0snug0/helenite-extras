<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL_PREFIX}}letterboxd-sync</string>

    <!-- Homebrew python, NOT /usr/bin/python3: that shim forwards to Xcode's
         python3, which launchd cannot use to read ~/Documents (EPERM). -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{VAULT}}/99_Internal/Templates/Scripts/letterboxd_daily.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{VAULT}}</string>

    <!-- Daily at 09:00 local. If the Mac is asleep at that moment launchd runs
         the job on wake; if it was powered off the day is skipped, and the next
         run reconciles it from the RSS feed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOGS}}/letterboxd-sync.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOGS}}/letterboxd-sync.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
