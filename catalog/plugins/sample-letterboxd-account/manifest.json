{
  "id": "letterboxd-account",
  "name": "Letterboxd account (sample)",
  "version": "0.1.0",
  "minAppVersion": "1.4.0",
  "description": "Sample account-type plugin: a Letterboxd account (public diary and watchlist) that vaults can be granted.",
  "author": "Helenite",
  "isDesktopOnly": true,
  "helenite": {
    "scope": "accounts",
    "accountTypes": [
      {
        "type": "letterboxd",
        "name": "Letterboxd",
        "hosts": ["https://letterboxd.com"],
        "secrets": [],
        "capabilities": [
          { "id": "diary.read", "label": "Read diary", "risk": "low", "paths": ["/*/rss/"] },
          { "id": "watchlist.read", "label": "Read watchlist", "risk": "low", "paths": ["/*/watchlist/"] }
        ],
        "methods": { "diary": "diary.read", "watchlist": "watchlist.read" }
      }
    ]
  }
}
